# Test-only image: the repo has no application image. Source is bind-mounted by
# docker-compose.test.yml, so code edits do not need a rebuild.
FROM python:3.12-bookworm

RUN apt-get update \
    && apt-get install -y --no-install-recommends unixodbc \
    && rm -rf /var/lib/apt/lists/*

# Debian's Node 18 lacks --experimental-strip-types, which the demo unit tests use.
COPY --from=node:22.12.0-bookworm-slim /usr/local/bin/node /usr/local/bin/node
COPY --from=node:22.12.0-bookworm-slim /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -s ../lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
    && ln -s ../lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx

WORKDIR /app

COPY requirements.txt constraints.txt package.json package-lock.json ./
RUN pip install --no-cache-dir -r requirements.txt typer pytest-xdist
RUN npm ci
RUN node node_modules/@playwright/test/cli.js install --with-deps chromium
